DJANGO_ENV=local

SECRET_KEY=changeme
DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost

CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

DB_ENGINE=django.db.backends.postgresql
DB_NAME=changeme
DB_USER=changeme
DB_PASSWORD=changeme
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer
DB_ATOMIC_REQUESTS=False

USE_X_FORWARDED_HOST=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

LOG_LEVEL=INFO

DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880

BRAVE_SEARCH_API_KEY=changeme
WEB_ANALYSIS_ENABLED=True
BRAVE_SEARCH_COUNTRY=ALL
BRAVE_SEARCH_LANG=es
WEB_ANALYSIS_TIMEOUT_SECONDS=10
WEB_ANALYSIS_MAX_QUERY_PHRASES=8
WEB_ANALYSIS_MAX_PAGES_TOTAL=16

# Experimental, solo local. Ver requirements-local.txt. NO activar en producción.
PERPLEXITY_AI_DETECTION_ENABLED=False

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
